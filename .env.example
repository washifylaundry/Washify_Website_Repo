# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# GOOGLE SEARCH CONSOLE & GOOGLE ANALYTICS 4 (GA4) CONFIGURATION
# ==============================================================================

# VITE_GOOGLE_SITE_VERIFICATION: Google Search Console HTML Meta Tag Verification Code.
# Obtain this token from Google Search Console -> Settings -> Ownership Verification -> HTML Tag.
# Example: VITE_GOOGLE_SITE_VERIFICATION="abc123xyz_verification_token_here"
VITE_GOOGLE_SITE_VERIFICATION="YOUR_GOOGLE_SITE_VERIFICATION_CODE"

# VITE_GA_MEASUREMENT_ID: Google Analytics 4 (GA4) Web Stream Measurement ID.
# Obtain this ID from Google Analytics -> Admin -> Data Streams -> Web Stream Details.
# Example: VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
VITE_GA_MEASUREMENT_ID="YOUR_GA_MEASUREMENT_ID"
